pkgname=omatranslate
pkgver=0.1.0
pkgrel=1
pkgdesc='Translate what you highlight in a PDF'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'layer-shell-qt' 'xdg-desktop-portal' 'wl-clipboard' 'xdg-utils')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omatranslate "$pkgdir/usr/bin/omatranslate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omatranslate.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omatranslate.svg"
  install -Dm644 "$startdir/omatranslate.desktop" "$pkgdir/usr/share/applications/omatranslate.desktop"
}
